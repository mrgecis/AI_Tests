# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Anthropic API Key (for Claude-based matching)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Gmail accounts to index (comma-separated)
GMAIL_ACCOUNTS=account1@gmail.com,account2@gmail.com,account3@gmail.com

# Matching configuration
AMOUNT_TOLERANCE_PCT=0.01
DATE_TOLERANCE_DAYS=3
MATCH_CONFIDENCE_THRESHOLD=0.65
